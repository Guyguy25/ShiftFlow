{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "rewrites": [
        { "source": "/", "destination": "/seo/home.html" },
        { "source": "/pricing", "destination": "/seo/pricing.html" },
        { "source": "/demo", "destination": "/seo/demo.html" },
        { "source": "/((?!api(?:/|$)).*)", "destination": "/app-shell.html" }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.py"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
