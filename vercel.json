{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "create-react-app",
      "rewrites": [
        { "source": "/test-accompagne", "destination": "/seo/test-accompagne.html" },
        { "source": "/", "destination": "/seo/home.html" },
        { "source": "/pricing", "destination": "/seo/pricing.html" },
        { "source": "/demo", "destination": "/seo/demo.html" },
        { "source": "/((?!api(?:/|$)).*)", "destination": "/app-shell.html" }
      ]
    },
    "backend": {
      "root": "backend",
      "entrypoint": "server.py"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ],
  "headers": [
    { "source": "/hours", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
    ] }
  ]
}
